# ─── BANCO DE DADOS ───────────────────────────────────────────────────────────
# Altere apenas a senha se o seu MySQL tiver senha (no XAMPP normalmente é vazia)
DATABASE_URL=mysql://root:@localhost:3306/expag_financial

# ─── AUTENTICAÇÃO ─────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-local-nao-usar-em-producao-32chars

# ─── MODO DEV LOCAL (não altere estas linhas) ─────────────────────────────────
OWNER_OPEN_ID=local-dev
OAUTH_SERVER_URL=https://api.manus.app
NODE_ENV=development
PORT=3000

# ─── FRONTEND ─────────────────────────────────────────────────────────────────
VITE_APP_ID=local-dev
VITE_OAUTH_PORTAL_URL=https://manus.app
